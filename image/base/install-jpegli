#!/bin/bash
set -e

JPEGLI_COMMIT="031a0077f5799a6041004267fc12b956c1f52a20"
JPEGLI_HASH="269b3a75d6b2da2351f7fb2d642043f60f9b6d1bd5839f20c0d7c569be073367"
HIGHWAY_COMMIT="271a9a0ed9de1232d9117f1572c3fe28f8542ec1"
HIGHWAY_HASH="c42bcfe44d100223ea0043acb3da6de703103ca44bfb1d46b577c90939177f5f"
LIBJPEG_TURBO_COMMIT="8ecba3647edb6dd940463fedf38ca33a8e2a73d1"
LIBJPEG_TURBO_HASH="ed729127097af5000bfeddc6b3e679c4363bb1618ebfc07efb6b47f576471b4b"
WDIR=/tmp/discourse-jpegli-0.12.0
PACKAGE_DIR=/tmp/jpegli-packages

export DEBIAN_FRONTEND=noninteractive
apt-get -y -q install debhelper ninja-build liblcms2-dev pkgconf

mkdir -p "$WDIR" "$PACKAGE_DIR"
wget -q -O /tmp/jpegli.tar.gz "https://github.com/google/jpegli/archive/$JPEGLI_COMMIT.tar.gz"
wget -q -O /tmp/highway.tar.gz "https://github.com/google/highway/archive/$HIGHWAY_COMMIT.tar.gz"
wget -q -O /tmp/libjpeg-turbo.tar.gz "https://github.com/libjpeg-turbo/libjpeg-turbo/archive/$LIBJPEG_TURBO_COMMIT.tar.gz"
echo "$JPEGLI_HASH  /tmp/jpegli.tar.gz" | sha256sum -c
echo "$HIGHWAY_HASH  /tmp/highway.tar.gz" | sha256sum -c
echo "$LIBJPEG_TURBO_HASH  /tmp/libjpeg-turbo.tar.gz" | sha256sum -c

tar zxf /tmp/jpegli.tar.gz --strip-components=1 -C "$WDIR"
mkdir -p "$WDIR/third_party/highway" "$WDIR/third_party/libjpeg-turbo"
tar zxf /tmp/highway.tar.gz --strip-components=1 -C "$WDIR/third_party/highway"
tar zxf /tmp/libjpeg-turbo.tar.gz --strip-components=1 -C "$WDIR/third_party/libjpeg-turbo"
rm -rf "$WDIR/debian"
cp -a /tmp/jpegli-packaging/debian "$WDIR/debian"

cd "$WDIR"
DEB_BUILD_OPTIONS="parallel=$(nproc)" dpkg-buildpackage -us -uc -b
cp ../discourse-libjpegli62_*.deb ../discourse-libjpegli-dev_*.deb "$PACKAGE_DIR/"
apt-get -y -q install "$PACKAGE_DIR"/discourse-libjpegli62_*.deb "$PACKAGE_DIR"/discourse-libjpegli-dev_*.deb

MULTIARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH)
test -e "/usr/lib/$MULTIARCH/discourse/jpegli/libjpeg.so.62"
test "$(pkg-config --modversion "/usr/lib/$MULTIARCH/discourse/jpegli/pkgconfig/libjpeg.pc")" = "62.3.0"
