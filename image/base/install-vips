#!/bin/bash
set -e

VIPS_VERSION="8.18.4"
VIPS_HASH="2677bad6c422617fd1172d359c16af34e736965d042c214203a87187d26ff037"
JPEGLI_VERSION="0.12.0~git20260601.031a007-1discourse1"
WDIR="/tmp/discourse-vips-$VIPS_VERSION"
PACKAGE_DIR=/tmp/vips-packages

export DEBIAN_FRONTEND=noninteractive
apt-get -y -q install --no-install-recommends devscripts equivs
apt-get -y -q install /tmp/jpegli-debs/discourse-libjpegli62_*.deb /tmp/jpegli-debs/discourse-libjpegli-dev_*.deb

mkdir -p "$WDIR" "$PACKAGE_DIR"
wget -q -O /tmp/vips.tar.xz "https://github.com/libvips/libvips/releases/download/v$VIPS_VERSION/vips-$VIPS_VERSION.tar.xz"
echo "$VIPS_HASH  /tmp/vips.tar.xz" | sha256sum -c
tar xf /tmp/vips.tar.xz --strip-components=1 -C "$WDIR"
cp -a /tmp/vips-packaging/debian "$WDIR/debian"

cd "$WDIR"
mk-build-deps --install --remove \
  --tool 'apt-get -y -q --no-install-recommends' \
  debian/control
DEB_BUILD_OPTIONS="parallel=$(nproc)" dpkg-buildpackage -us -uc -b
cp ../discourse-libvips42_*.deb ../discourse-vips-tools_*.deb "$PACKAGE_DIR/"
apt-get -y -q install "$PACKAGE_DIR"/discourse-libvips42_*.deb "$PACKAGE_DIR"/discourse-vips-tools_*.deb
ldconfig

MULTIARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH)
test "$(dpkg-query -W -f='${Version}' discourse-libjpegli62)" = "$JPEGLI_VERSION"
test "$(command -v vips)" = /usr/bin/vips
test "$(command -v vipsheader)" = /usr/bin/vipsheader
ldd "/usr/lib/$MULTIARCH/libvips.so.42" | grep -q "/usr/lib/$MULTIARCH/discourse/jpegli/libjpeg.so.62"
for operation in jpegload jpegsave pngload gifload gifsave webpload tiffload heifload jxlload svgload text thumbnail autorot gravity flatten; do
  vips -l "$operation" >/dev/null
done
for operation in magickload magicksave pdfload; do
  if vips -l "$operation" >/dev/null 2>&1; then
    echo "ERROR: vips exposes forbidden operation: $operation"
    exit 1
  fi
done
if ldd "/usr/lib/$MULTIARCH/libvips.so.42" | grep -Eqi 'libMagick|libpoppler|libgs\.so'; then
  echo "ERROR: vips links to a forbidden image or PDF library"
  exit 1
fi

dpkg-query -W -f='${Depends}' discourse-vips-tools | grep -q "discourse-libvips42 (= $VIPS_VERSION-1discourse1)"
dpkg-query -W -f='${Depends}' discourse-libvips42 | grep -q "discourse-libjpegli62 (= $JPEGLI_VERSION)"
dpkg-query -W -f='${Provides}' discourse-libvips42 | grep -q "libvips42t64 (= $VIPS_VERSION-1discourse1)"
dpkg-query -W -f='${Conflicts}' discourse-libvips42 | grep -q 'libvips42t64'
dpkg-query -W -f='${Replaces}' discourse-libvips42 | grep -q 'libvips42t64'
dpkg-query -W -f='${Provides}' discourse-vips-tools | grep -q "libvips-tools (= $VIPS_VERSION-1discourse1)"
dpkg-query -W -f='${Conflicts}' discourse-vips-tools | grep -q 'libvips-tools'
dpkg-query -W -f='${Replaces}' discourse-vips-tools | grep -q 'libvips-tools'
