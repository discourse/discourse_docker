#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure --buildsystem=meson -- \
		--buildtype=plain \
		--auto-features=disabled \
		-Ddeprecated=false \
		-Dexamples=false \
		-Dcplusplus=false \
		-Dppm=false \
		-Danalyze=false \
		-Dradiance=false \
		-Dmodules=disabled \
		-Dmagick=disabled \
		-Dhighway=disabled \
		-Dzlib=enabled \
		-Djpeg=enabled \
		-Dpng=enabled \
		-Dwebp=enabled \
		-Dtiff=enabled \
		-Dheif=enabled \
		-Djpeg-xl=enabled \
		-Drsvg=enabled \
		-Dcgif=enabled \
		-Dexif=enabled \
		-Dlcms=enabled \
		-Dorc=enabled \
		-Dimagequant=enabled \
		-Dfontconfig=enabled \
		-Dpangocairo=enabled

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
