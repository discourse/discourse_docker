#!/bin/bash
set -e

JHEAD_COMMIT="4d04ac965632e35a65709c7f92a857a749e71811"
OXIPNG_VERSION="10.1.1"
PACKAGE_DIR=/tmp/image-tool-packages

case "$(dpkg --print-architecture)" in
  amd64)
    OXIPNG_FILE="oxipng-${OXIPNG_VERSION}-x86_64-unknown-linux-musl.tar.gz"
    OXIPNG_HASH="a7e13e06040dea5fe1298668ac99afbe0ed781610a9e4b27d62a8850b3fdf273"
    ;;
  arm64)
    OXIPNG_FILE="oxipng-${OXIPNG_VERSION}-aarch64-unknown-linux-musl.tar.gz"
    OXIPNG_HASH="d8b599202378b038fc7571ba6ffd5f65592529a694f0315a7d436863c56029ed"
    ;;
  *)
    echo "unsupported architecture: $(dpkg --print-architecture)" >&2
    exit 1
    ;;
esac

export DEBIAN_FRONTEND=noninteractive
apt-get -y -q install debhelper
mkdir -p "$PACKAGE_DIR"

JHEAD_DIR=/tmp/discourse-jhead-3.08
git init -q "$JHEAD_DIR"
git -C "$JHEAD_DIR" fetch -q --depth 1 https://github.com/Matthias-Wandel/jhead.git "$JHEAD_COMMIT"
git -C "$JHEAD_DIR" checkout -q "$JHEAD_COMMIT"
rm -rf "$JHEAD_DIR/.git"
cp -a /tmp/jhead-packaging/debian "$JHEAD_DIR/debian"
cd "$JHEAD_DIR"
DEB_BUILD_OPTIONS="parallel=$(nproc)" dpkg-buildpackage -us -uc -b
cp ../discourse-jhead_*.deb "$PACKAGE_DIR/"

OXIPNG_DIR=/tmp/discourse-oxipng-$OXIPNG_VERSION
mkdir -p "$OXIPNG_DIR/upstream"
wget -q -O "/tmp/$OXIPNG_FILE" "https://github.com/oxipng/oxipng/releases/download/v$OXIPNG_VERSION/$OXIPNG_FILE"
echo "$OXIPNG_HASH  /tmp/$OXIPNG_FILE" | sha256sum -c
tar --strip-components=1 -xzf "/tmp/$OXIPNG_FILE" -C "$OXIPNG_DIR/upstream"
cp -a /tmp/oxipng-packaging/debian "$OXIPNG_DIR/debian"
cd "$OXIPNG_DIR"
dpkg-buildpackage -us -uc -b
cp ../discourse-oxipng_*.deb "$PACKAGE_DIR/"

apt-get -y -q install "$PACKAGE_DIR"/discourse-jhead_*.deb "$PACKAGE_DIR"/discourse-oxipng_*.deb
jhead -V
oxipng --version
