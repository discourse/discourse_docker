@@ -1325,6 +1366,23 @@ de265_error decoder_context::decode_slice_unit_WPP(image_unit* imgunit,
     return DE265_WARNING_SLICEHEADER_INVALID;
   }
 
+  // Reset the decoding progress of all CTBs that the row tasks of this slice
